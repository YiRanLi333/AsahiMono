; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="AsahiMono"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.5", "C#", "Mobile")
; iOS export generates every App Icon slot from this. If it is empty the exporter
; aborts with: ERROR: Export Icons: Invalid icon (icons/settings_58x58): ''.
config/icon="res://icon.png"

[display]

; Portrait, iPhone 12 logical points. The DevPreview SubViewport is the same size, so the
; game inside the fake phone body is pixel-for-pixel what the device runs.
window/size/viewport_width=390
window/size/viewport_height=844
window/handheld/orientation=1

[dotnet]

project/assembly_name="AsahiMono"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Pixel art: nearest neighbour, no blur. 0 = TEX_FILTER_NEAREST.
textures/canvas_textures/default_texture_filter=0
; Required for Apple Embedded export. Godot's has_valid_project_configuration()
; returns false when this is off and prints NO reason for it
; (editor/export/editor_export_platform_apple_embedded.cpp:2293).
textures/vram_compression/import_etc2_astc=true
