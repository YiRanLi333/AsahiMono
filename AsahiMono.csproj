<Project Sdk="Godot.NET.Sdk/4.5.2">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>AsahiMono</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <!--
    The Godot assembly lives next to the engine-free projects, so its default
    recursive glob has to be narrowed: only Adapters/** and Scripts/** belong to it.
    Game.Core builds on its own and is referenced, never recompiled into this assembly.
  -->
  <ItemGroup>
    <Compile Remove="Game.Core/**/*.cs" />
    <Compile Remove="Game.Core.Tests/**/*.cs" />
    <Compile Remove="Tools/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Game.Core/Game.Core.csproj" />
  </ItemGroup>

</Project>
